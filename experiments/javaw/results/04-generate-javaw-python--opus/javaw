#!/usr/bin/env python3
"""javaw: generate a relocatable POSIX sh launcher script for a Java program."""
import argparse, os, re, shlex, sys

RESOLVE = '''self=$0
while [ -L "$self" ]; do
  link=$(readlink -- "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
dir=$(dirname -- "$self")
case $dir in /*) ;; *) dir=./$dir ;; esac
dir=$(CDPATH= cd -P -- "$dir" && pwd -P) || exit 1
'''

VERSION_CHECK = '''found=$({java} -version 2>&1 | sed -n 's/^[^ ]* version "\\([^"]*\\)".*/\\1/p' | head -n 1)
major=${{found#1.}}
major=${{major%%[!0-9]*}}
if [ -z "$major" ] || [ "$major" -lt {min} ]; then
  echo "error: Java {min} or newer is required (found: ${{found:-no usable java}})" >&2
  exit 1
fi
'''


def kebab(name):
    s = re.sub(r"([A-Z]+)([A-Z][a-z])", r"\1-\2", name)  # HTTPServer -> HTTP-Server
    s = re.sub(r"([a-z0-9])([A-Z])", r"\1-\2", s)        # FooBar -> Foo-Bar
    return re.sub(r"[-_.\s]+", "-", s).strip("-").lower()


def default_name(path):
    return "run-" + kebab(os.path.splitext(os.path.basename(path))[0])


def dq(s):
    """Escape s for use inside a double-quoted sh string."""
    return re.sub(r'([\\"$`])', r"\\\1", s)


def wrapper(args, program, command):
    java = shlex.quote(os.path.join(args.java_home, "bin", "java")) if args.java_home else "java"
    launch = ["exec", java]
    if args.classpath:
        launch += ["-cp", shlex.quote(args.classpath)]
    launch += [shlex.quote(o) for o in shlex.split(args.jvm_opts or "")]
    launch += ["-jar"] if args.jar else []
    launch += ['"$dir/%s"' % dq(program), '"$@"']
    check = VERSION_CHECK.format(java=java, min=args.min_java) if args.min_java else ""
    return "#!/bin/sh\n# Generated by: %s\n%s%s%s\n" % (command, RESOLVE, check, " ".join(launch))


def parse(argv):
    p = argparse.ArgumentParser(
        prog="javaw", description="Generate a launcher shell script for a Java program.",
        epilog="examples:\n  javaw Tool.java\n  javaw --jar tool.jar -o bin/tool\n"
               "  javaw --min-java 17 --jvm-opts '-Xmx1g' A.java B.java -o bin/",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("inputs", nargs="+", metavar="INPUT", help="Java source file (or jar with --jar)")
    p.add_argument("--jar", action="store_true", help="inputs are jars, launched with java -jar")
    p.add_argument("--classpath", metavar="PATH", help="classpath passed as -cp, recorded as-is")
    p.add_argument("--java-home", metavar="DIR", help="use DIR/bin/java instead of java from PATH")
    p.add_argument("--jvm-opts", metavar="OPTS", help='JVM options, e.g. "-Xmx1g -Dk=v"')
    p.add_argument("--min-java", metavar="N", type=int, help="fail unless Java version is at least N")
    p.add_argument("-o", "--output", metavar="NAME", help="output file, or directory (ends in / or exists)")
    p.add_argument("--force", action="store_true", help="overwrite existing files")
    # Let option values start with "-" (e.g. --jvm-opts -Xmx1g) by joining them as --opt=value.
    joined, valued = [], {"--classpath", "--java-home", "--jvm-opts", "--min-java", "--output", "-o"}
    for a in argv:
        if joined and joined[-1] in valued:
            joined[-1] += ("" if joined[-1] == "-o" else "=") + a
        else:
            joined.append(a)
    return p, p.parse_args(joined)


def main(argv):
    p, args = parse(argv)
    out = args.output
    is_dir = out is not None and (out.endswith("/") or os.path.isdir(out))
    if out is not None and len(args.inputs) > 1 and not is_dir:
        p.error("-o must be a directory when there are several inputs")
    try:
        shlex.split(args.jvm_opts or "")
    except ValueError as e:
        p.error("--jvm-opts: %s" % e)
    targets = []
    for src in args.inputs:
        if not os.path.isfile(src):
            p.error("input not found: %s" % src)
        dest = os.path.join(out, default_name(src)) if is_dir else out or default_name(src)
        if os.path.lexists(dest) and not args.force:
            p.error("%s already exists (use --force to overwrite)" % dest)
        if dest in [d for _, d in targets]:
            p.error("several inputs would be written to %s" % dest)
        targets.append((src, dest))
    command = " ".join(["javaw"] + [shlex.quote(a) for a in argv])
    for src, dest in targets:
        outdir = os.path.dirname(os.path.abspath(dest))
        os.makedirs(outdir, exist_ok=True)
        program = os.path.relpath(os.path.abspath(src), outdir)
        if os.path.lexists(dest):
            os.remove(dest)
        with open(dest, "w") as f:
            f.write(wrapper(args, program, command))
        os.chmod(dest, 0o755)
        print("wrote %s" % dest)


if __name__ == "__main__":
    main(sys.argv[1:])
