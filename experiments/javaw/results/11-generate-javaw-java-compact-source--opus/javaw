#!/bin/sh
# Generated by javaw. Regenerate with:
#   javaw Javaw.java -o javaw --min-java 25
self=$0
case $self in /*) ;; *) self=./$self ;; esac
while [ -h "$self" ]; do
  link=$(readlink "$self") || exit 1
  case $link in /*) self=$link ;; *) self=${self%/*}/$link ;; esac
done
dir=$(CDPATH= cd -P -- "${self%/*}/" && pwd -P) || exit 1
v=$(java -version 2>&1 | sed -n 's/^[A-Za-z]* version "\([^"]*\)".*/\1/p' | head -n 1)
case $v in 1.*) n=${v#1.} ;; *) n=$v ;; esac
n=${n%%[!0-9]*}
if [ -z "$n" ] || [ "$n" -lt 25 ]; then
  echo "error: Java 25 or newer is required, but java reports version: ${v:-unknown}" >&2
  exit 1
fi
exec java "$dir/Javaw.java" "$@"
