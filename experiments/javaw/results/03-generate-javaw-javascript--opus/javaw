#!/usr/bin/env node
// javaw: generate a relocatable POSIX sh launcher script for a Java program.
'use strict';
const fs = require('fs');
const path = require('path');

const HELP = `Usage: javaw [options] FILE.java... | --jar FILE.jar

Generate an executable POSIX sh wrapper that launches a Java program.

Options:
  --jar FILE          launch FILE with java -jar (may be repeated)
  --classpath PATH    add -cp PATH to the launch command (recorded as-is)
  --java-home DIR     use DIR/bin/java instead of java from the PATH
  --jvm-opts "OPTS"   JVM options placed before the program
  --min-java N        fail with a clear error if Java is older than N
  -o, --output NAME   wrapper path; a directory if it ends in / or exists
  --force             overwrite existing files
  -h, --help          show this help

The default wrapper name is run-<kebab-case input name>, e.g.
Tool.java -> run-tool, HTTPServer.java -> run-http-server.
`;

class UsageError extends Error {}

const kebab = (s) => s
  .replace(/([a-z0-9])([A-Z])/g, '$1-$2')    // fooBar, example1Foo
  .replace(/([A-Z]+)([A-Z][a-z])/g, '$1-$2') // HTTPServer
  .replace(/[\s_.-]+/g, '-')
  .replace(/^-+|-+$/g, '')
  .toLowerCase();

const defaultName = (file) => 'run-' + kebab(path.parse(file).name);

const quote = (s) => /^[\w@%+=:,./-]+$/.test(s) ? s : `'${s.replace(/'/g, `'\\''`)}'`;

const stat = (p) => fs.statSync(p, { throwIfNoEntry: false });

function parseArgs(argv) {
  const valued = { '--jar': 'jar', '--classpath': 'classpath', '--java-home': 'javaHome',
    '--jvm-opts': 'jvmOpts', '--min-java': 'minJava', '-o': 'output', '--output': 'output' };
  const o = { inputs: [], recorded: [] };
  for (let i = 0; i < argv.length; i++) {
    let a = argv[i], v;
    const eq = a.startsWith('--') ? a.indexOf('=') : -1;
    if (eq > 0) [a, v] = [a.slice(0, eq), a.slice(eq + 1)];
    if (a === '--') { argv.slice(i + 1).forEach((f) => o.inputs.push({ file: f })); break; }
    if (a === '-h' || a === '--help') o.help = true;
    else if (a === '--force') { o.force = true; o.recorded.push(a); }
    else if (a in valued) {
      if (v === undefined) {
        if (i + 1 >= argv.length) throw new UsageError(`option ${a} requires a value`);
        v = argv[++i];
      }
      if (a === '--jar') o.inputs.push({ file: v, jar: true });
      else { o[valued[a]] = v; o.recorded.push(a, v); }
    } else if (a.startsWith('-') && a !== '-') throw new UsageError(`unknown option: ${a}`);
    else o.inputs.push({ file: a });
  }
  return o;
}

function wrapper(o, input, out) {
  const real = (p) => fs.realpathSync(p);
  const rel = path.relative(real(path.dirname(out)), real(input.file));
  const prog = quote(rel) === rel ? `"$dir/${rel}"` : `"$dir"/${quote(rel)}`;
  const java = o.javaHome === undefined ? 'java' : quote(path.join(o.javaHome, 'bin/java'));
  const run = [java,
    ...(o.jvmOpts ? o.jvmOpts.trim().split(/\s+/).map(quote) : []),
    ...(o.classpath !== undefined ? ['-cp', quote(o.classpath)] : []),
    ...(input.jar ? ['-jar'] : []), prog];
  const cmd = ['javaw', ...o.recorded, ...(input.jar ? ['--jar'] : input.file.startsWith('-') ? ['--'] : []),
    input.file].map(quote).join(' ');
  return `#!/bin/sh
# Generated by javaw. Regenerate with:
#   ${cmd}
self=$0
while [ -L "$self" ]; do
  link=$(readlink -- "$self") || exit 1
  case $link in
    /*) self=$link ;;
    *) self=$(dirname -- "$self")/$link ;;
  esac
done
dir=$(CDPATH= cd -P -- "$(dirname -- "$self")" && pwd -P) || exit 1
${o.minJava === undefined ? '' : `v=$(${java} -version 2>&1 | sed -n 's/^[^ ]* version "\\([^"]*\\)".*/\\1/p' | head -n 1)
n=\${v#1.}
n=\${n%%[!0-9]*}
if [ -z "$n" ] || [ "$n" -lt ${o.minJava} ]; then
  echo "\${0##*/}: Java ${o.minJava} or newer is required (found: \${v:-no usable java})" >&2
  exit 1
fi
`}exec ${run.join(' ')} "$@"
`;
}

function main(argv) {
  const o = parseArgs(argv);
  if (o.help) return process.stdout.write(HELP);
  if (!o.inputs.length) throw new UsageError('missing input file');
  if (o.minJava !== undefined && !/^[1-9]\d*$/.test(o.minJava)) {
    throw new UsageError(`--min-java must be a positive integer: ${o.minJava}`);
  }
  for (const { file, jar } of o.inputs) {
    if (!jar && file.endsWith('.jar')) throw new UsageError(`${file}: use --jar to launch a jar`);
    if (!stat(file)?.isFile()) throw new Error(`${file}: no such file`);
  }
  let outDir = '.', outName;
  if (o.output !== undefined) {
    if (o.output.endsWith('/') || stat(o.output)?.isDirectory()) outDir = o.output;
    else if (o.inputs.length > 1) throw new UsageError('-o must be a directory when several inputs are given');
    else [outDir, outName] = [path.dirname(o.output), path.basename(o.output)];
  }
  const jobs = o.inputs.map((input) => ({ input, out: path.join(outDir, outName ?? defaultName(input.file)) }));
  const seen = new Set();
  for (const { out } of jobs) {
    if (seen.has(out)) throw new Error(`${out}: generated more than once; use separate runs with -o`);
    seen.add(out);
    if (!o.force && fs.lstatSync(out, { throwIfNoEntry: false })) {
      throw new Error(`${out}: already exists (use --force to overwrite)`);
    }
  }
  fs.mkdirSync(outDir, { recursive: true });
  for (const { input, out } of jobs) {
    fs.rmSync(out, { force: true });
    fs.writeFileSync(out, wrapper(o, input, out), { mode: 0o755 });
    fs.chmodSync(out, 0o755);
    console.log(`wrote ${out}`);
  }
}

if (require.main === module) {
  try {
    main(process.argv.slice(2));
  } catch (e) {
    console.error(`javaw: ${e.message}`);
    if (e instanceof UsageError) console.error("Try 'javaw --help' for more information.");
    process.exit(e instanceof UsageError ? 2 : 1);
  }
}

module.exports = { kebab, defaultName, quote, parseArgs };
