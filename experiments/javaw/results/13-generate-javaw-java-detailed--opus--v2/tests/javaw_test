void dependencies() {
    if (shell(work, Map.of(), "command -v jbang").code() != 0) throw new Skip("jbang is not installed");
    if (shell(work, Map.of(), "curl -fsI https://repo1.maven.org/maven2/ >/dev/null").code() != 0) throw new Skip("Maven Central is unreachable");
    var dir = mkdirs("deps");
    var source = """
            //DEPS org.slf4j:slf4j-simple:2.0.13
            void main(String[] args) {
                System.setProperty("org.slf4j.simpleLogger.logFile", "System.out");
                org.slf4j.LoggerFactory.getLogger("demo").info("hello {}", List.of(args));
            }
            """;
    write(dir.resolve("Log.java"), source);
    write(dir.resolve("Log2.java"), source);
    ok(javaw(dir, "Log.java", "Log2.java"));
    var script = read(dir.resolve("run-log"));
    var fetches = script.lines().filter(l -> l.startsWith("  fetch ")).toList();
    equal(2, fetches.size(), "one line per jar, transitive slf4j-api included");
    for (var f : fetches) check(f.matches("  fetch org/slf4j/[a-z0-9-]+/2\\.0\\.13/[a-z0-9.-]+\\.jar [0-9a-f]{64}"), "pinned line: " + f);
    var first = ok(shell(dir, Map.of(), "./run-log a"));
    equal("[main] INFO demo - hello [a]\n", first.out());
    contains(first.err(), "downloading https://repo1.maven.org/maven2/org/slf4j/slf4j-api/2.0.13/slf4j-api-2.0.13.jar");
    check(Files.isRegularFile(dir.resolve("lib/org/slf4j/slf4j-api/2.0.13/slf4j-api-2.0.13.jar")), "jar in lib/");
    equal("*\n", read(dir.resolve("lib/.gitignore")));
    check(Files.isRegularFile(dir.resolve(".run-log/deps.ok")), "completion marker");
    var second = ok(shell(dir, Map.of(), "./run-log2 b"));
    equal("", second.err(), "the second wrapper reuses lib/ without downloading");

    // Offline first run: a clear error.
    shell(dir, Map.of(), "rm -rf lib .run-log");
    var proxy = Map.of("https_proxy", "http://127.0.0.1:9", "HTTPS_PROXY", "http://127.0.0.1:9");
    var offline = shell(dir, proxy, "./run-log");
    equal(1, offline.code());
    contains(offline.err(), "run-log: cannot download https://repo1.maven.org/maven2/org/slf4j/slf4j-simple/2.0.13/slf4j-simple-2.0.13.jar (offline?)");
    try (var files = Files.walk(dir.resolve("lib"))) {
        check(files.noneMatch(p -> p.toString().endsWith(".jar") || p.getFileName().toString().matches(".*\\.jar\\.[0-9]+")), "no partial jars left");
    } catch (IOException e) {
        throw new UncheckedIOException(e);
    }

    // No curl: a clear error naming curl. PATH gets everything from /bin and /usr/bin except curl, plus java.
    var tools = mkdirs("deps/no-curl");
    ok(shell(tools, Map.of(), """
            for f in /bin/* /usr/bin/*; do n=${f##*/}; [ "$n" = curl ] || [ -e "$n" ] || ln -s "$f" "$n"; done
            for t in java javac jar; do ln -sf "$(command -v $t)" $t; done
            """));
    var noCurl = shell(dir, Map.of("PATH", tools.toString()), "./run-log");
    equal(1, noCurl.code());
    equal("run-log: curl is required to download dependencies, but it is not installed\n", noCurl.err());

    // A tampered pin is refused.
    write(dir.resolve("run-log"), script.replaceFirst(" [0-9a-f]{64}\n", " " + "0".repeat(64) + "\n"));
    var tampered = shell(dir, Map.of(), "./run-log");
    equal(1, tampered.code());
    contains(tampered.err(), "SHA-256 mismatch");
}

// ---- Helpers ----

static final class Skip extends RuntimeException {
    Skip(String reason) { super(reason); }
}

static Result javaw(Path cwd, String... args) {
    var command = new ArrayList<String>(List.of(javaw.toString()));
    command.addAll(List.of(args));
    return run(cwd, Map.of(), command.toArray(String[]::new));
}

static Result shell(Path cwd, Map<String, String> env, String script) {
    return run(cwd, env, "/bin/sh", "-c", script);
}

static Result run(Path cwd, Map<String, String> env, String... command) {
    try {
        var err = Files.createTempFile(work, "stderr", ".txt");
        var pb = new ProcessBuilder(command).directory(cwd.toFile()).redirectError(err.toFile());
        pb.environment().remove("JAVA_TOOL_OPTIONS");
        pb.environment().remove("CDPATH");
        pb.environment().put("JAVAW", javaw.toString());
        pb.environment().putAll(env);
        var process = pb.start();
        process.getOutputStream().close();
        var out = new String(process.getInputStream().readAllBytes(), StandardCharsets.UTF_8);
        if (!process.waitFor(5, TimeUnit.MINUTES)) {
            process.destroyForcibly();
            throw new AssertionError("timed out: " + String.join(" ", command));
        }
        var errText = Files.readString(err).lines()
                .filter(l -> !l.equals("WARNING: Using incubator modules: jdk.incubator.json"))
                .map(l -> l + "\n").collect(Collectors.joining());
        Files.delete(err);
        return new Result(process.exitValue(), out, errText);
    } catch (IOException e) {
        throw new UncheckedIOException(e);
    } catch (InterruptedException e) {
        throw new IllegalStateException(e);
    }
}

/// The POSIX shells to run wrappers with: sh always, others when installed.
static List<String> shells() {
    return Stream.of("sh", "dash", "ksh", "bash").filter(s -> shell(work, Map.of(), "command -v " + s).code() == 0).toList();
}

static Result ok(Result r) {
    if (r.code() != 0) throw new AssertionError("exit " + r.code() + "\nstdout: " + r.out() + "stderr: " + r.err());
    return r;
}

static void check(boolean condition, String what) {
    if (!condition) throw new AssertionError(what);
}

static void equal(Object expected, Object actual) {
    equal(expected, actual, "");
}

static void equal(Object expected, Object actual, String what) {
    if (!Objects.equals(expected, actual)) {
        throw new AssertionError((what.isEmpty() ? "" : what + ": ") + "expected <" + expected + "> but was <" + actual + ">");
    }
}

static void contains(String text, String part) {
    if (!text.contains(part)) throw new AssertionError("expected to find <" + part + "> in:\n" + text);
}

static Path mkdirs(String relative) {
    try {
        return Files.createDirectories(work.resolve(relative));
    } catch (IOException e) {
        throw new UncheckedIOException(e);
    }
}

static void write(Path file, String text) {
    try {
        Files.createDirectories(file.getParent());
        Files.writeString(file, text);
    } catch (IOException e) {
        throw new UncheckedIOException(e);
    }
}

static String read(Path file) {
    try {
        return Files.readString(file);
    } catch (IOException e) {
        throw new UncheckedIOException(e);
    }
}

static void delete(Path root) throws IOException {
    try (var paths = Files.walk(root)) {
        for (var p : paths.sorted(Comparator.reverseOrder()).toList()) Files.delete(p);
    }
}
