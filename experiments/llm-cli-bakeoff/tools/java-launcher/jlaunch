#!/usr/bin/env bash
# jlaunch: a tiny launcher/shim giving Java "script" ergonomics with
# near-jar/AOT startup. First run: hash the source tree, compile once,
# build a jar and an AOT cache into ~/.cache/jlaunch/<hash>/. Later
# runs: if the source hasn't changed, skip straight to `java -XX:AOTCache=...`.
#
# Usage: jlaunch <dir-containing-one-or-more-.java-files> <MainClassName> [args...]
set -euo pipefail

SRC_DIR="$1"; MAIN="$2"; shift 2

: "${JAVA_HOME:?set JAVA_HOME}"
JAVA="$JAVA_HOME/bin/java"
JAVAC="$JAVA_HOME/bin/javac"
JAR="$JAVA_HOME/bin/jar"

CACHE_ROOT="${JLAUNCH_CACHE:-$HOME/.cache/jlaunch}"

# Hash: source file contents + JDK version, so a JDK upgrade invalidates the cache.
HASH=$(
  { "$JAVA" -version 2>&1; cat "$SRC_DIR"/*.java; } | shasum -a 256 | cut -d' ' -f1
)
ENTRY="$CACHE_ROOT/$HASH"

if [ ! -f "$ENTRY/app.aot" ]; then
  mkdir -p "$ENTRY/classes"
  "$JAVAC" -d "$ENTRY/classes" "$SRC_DIR"/*.java
  (cd "$ENTRY/classes" && "$JAR" cfe "$ENTRY/app.jar" "$MAIN" .)
  "$JAVA" -XX:AOTMode=record -XX:AOTConfiguration="$ENTRY/app.aotconf" -jar "$ENTRY/app.jar" --help >/dev/null 2>&1 || true
  "$JAVA" -XX:AOTMode=create -XX:AOTConfiguration="$ENTRY/app.aotconf" -XX:AOTCache="$ENTRY/app.aot.tmp" -jar "$ENTRY/app.jar" >/dev/null 2>&1
  mv "$ENTRY/app.aot.tmp" "$ENTRY/app.aot"
fi

exec "$JAVA" -XX:AOTCache="$ENTRY/app.aot" -jar "$ENTRY/app.jar" "$@"
