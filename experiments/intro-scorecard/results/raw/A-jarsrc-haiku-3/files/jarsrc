#!/usr/bin/env python3
"""jarsrc: query a Gradle-cache-like tree of *-sources.jar files. See SPEC.md."""

import os
import re
import sys
import zipfile
from collections import namedtuple
from functools import cmp_to_key

HELP = """\
usage:
  jarsrc find <fqcn-or-glob> [--root DIR]
  jarsrc cat <fqcn> [--lines A:B] [--root DIR]
  jarsrc ls <group:artifact[:version]> [--root DIR]
  jarsrc --help

subcommands:
  find   list every class whose FQCN matches; * matches a run without dots, ** any run
  cat    print the source of a class from its highest version
  ls     list versions of group:artifact, or classes inside group:artifact:version

flags:
  --root DIR     root of the cache tree (default: .)
  --lines A:B    cat only: print lines A through B (1-indexed, inclusive)
  --help         print this message and exit
"""

SUBCOMMANDS = ("find", "cat", "ls")
FLAG_NAMES = ("--root", "--lines")

Artifact = namedtuple("Artifact", "group artifact version path")


class Fail(Exception):
    """Non-zero exit. `code` is 1 for not-found and 2 for usage or read errors."""

    def __init__(self, code, line):
        super().__init__(line)
        self.code = code
        self.line = line


def write(stream, lines):
    text = "".join(line.rstrip(" \t\f\v") + "\n" for line in lines)
    stream.buffer.write(text.encode("utf-8", "backslashreplace"))
    stream.flush()


def compare_versions(a, b):
    sa = re.split(r"[.-]", a)
    sb = re.split(r"[.-]", b)
    for x, y in zip(sa, sb):
        if re.fullmatch(r"[0-9]+", x) and re.fullmatch(r"[0-9]+", y):
            if int(x) != int(y):
                return -1 if int(x) < int(y) else 1
        elif x.encode("utf-8") != y.encode("utf-8"):
            return -1 if x.encode("utf-8") < y.encode("utf-8") else 1
    if len(sa) != len(sb):
        return -1 if len(sa) < len(sb) else 1
    return 0


VERSION_KEY = cmp_to_key(compare_versions)


def scan_artifacts(root):
    """Every <root>/<group dirs>/<artifact>/<version>/<artifact>-<version>-sources.jar."""
    found = []
    for dirpath, _, filenames in os.walk(root):
        for name in filenames:
            if not name.endswith("-sources.jar"):
                continue
            parts = os.path.relpath(os.path.join(dirpath, name), root).split(os.sep)
            if len(parts) < 4:
                continue
            artifact, version = parts[-3], parts[-2]
            if name != f"{artifact}-{version}-sources.jar":
                continue
            group = ".".join(parts[:-3])
            found.append(Artifact(group, artifact, version, os.path.join(dirpath, name)))
    return found


def jar_classes(path):
    """FQCNs of every .java entry in a sources jar."""
    try:
        with zipfile.ZipFile(path) as zf:
            names = zf.namelist()
    except (OSError, zipfile.BadZipFile):
        raise Fail(2, f"error: cannot read {path}")
    return frozenset(n[: -len(".java")].replace("/", ".") for n in names if n.endswith(".java"))


def load_index(root):
    return [(art, jar_classes(art.path)) for art in scan_artifacts(root)]


def simple_names(index):
    return {c.rsplit(".", 1)[-1] for _, classes in index for c in classes}


def suggest(prefix, known):
    return sorted({k for k in known if k.startswith(prefix)})[:3]


def not_found(what, suggestions):
    if not suggestions:
        return f"error: {what}"
    return f"error: {what} (did you mean: {', '.join(suggestions)}?)"


def glob_to_regex(pattern):
    parts = []
    for tok in re.split(r"(\*\*|\*)", pattern):
        if tok == "**":
            parts.append(".*")
        elif tok == "*":
            parts.append("[^.]*")
        else:
            parts.append(re.escape(tok))
    return re.compile("".join(parts))


def read_source(path, fqcn):
    name = fqcn.replace(".", "/") + ".java"
    try:
        with zipfile.ZipFile(path) as zf:
            data = zf.read(name)
    except (OSError, zipfile.BadZipFile, KeyError):
        raise Fail(2, f"error: cannot read {name} from {path}")
    return data.decode("utf-8", errors="replace")


def split_lines(text):
    lines = re.split(r"\r\n|\r|\n", text)
    if lines and lines[-1] == "":
        lines.pop()
    return lines


def parse_lines(value):
    m = re.fullmatch(r"([0-9]+):([0-9]+)", value)
    if not m:
        raise Fail(2, f"error: --lines expects A:B, got {value}")
    return int(m[1]), int(m[2])


def cmd_find(pattern, root):
    rx = glob_to_regex(pattern)
    index = load_index(root)
    hits = set()
    for art, classes in index:
        gav = f"{art.group}:{art.artifact}:{art.version}"
        for c in classes:
            if rx.fullmatch(c):
                hits.add((c, gav))
    if not hits:
        last = pattern.rsplit(".", 1)[-1]
        raise Fail(1, not_found(f"no matches for {pattern}", suggest(last, simple_names(index))))
    return [f"{c} {gav}" for c, gav in sorted(hits)]


def cmd_cat(fqcn, root, line_range):
    index = load_index(root)
    matches = [art for art, classes in index if fqcn in classes]
    if not matches:
        last = fqcn.rsplit(".", 1)[-1]
        raise Fail(1, not_found(f"no source for {fqcn}", suggest(last, simple_names(index))))
    gas = sorted({f"{a.group}:{a.artifact}" for a in matches})
    if len(gas) > 1:
        raise Fail(2, f"error: {fqcn} is ambiguous across: {', '.join(gas)}")
    best = max(matches, key=lambda a: VERSION_KEY(a.version))
    lines = split_lines(read_source(best.path, fqcn))
    if line_range is None:
        return lines
    start, end = max(line_range[0], 1), min(line_range[1], len(lines))
    return lines[start - 1 : end] if start <= end else []


def cmd_ls(target, root):
    parts = target.split(":")
    if len(parts) not in (2, 3) or not all(parts):
        raise Fail(2, f"error: expected group:artifact[:version], got {target}")
    group, artifact = parts[0], parts[1]
    version = parts[2] if len(parts) == 3 else None
    ga = f"{group}:{artifact}"

    arts = scan_artifacts(root)
    same_ga = [a for a in arts if a.group == group and a.artifact == artifact]
    if not same_ga:
        all_ga = {f"{a.group}:{a.artifact}" for a in arts}
        raise Fail(1, not_found(f"no artifact {ga}", suggest(ga, all_ga)))
    if version is None:
        return [a.version for a in sorted(same_ga, key=lambda a: VERSION_KEY(a.version))]

    matching = [a for a in same_ga if a.version == version]
    if not matching:
        all_ga = {f"{a.group}:{a.artifact}" for a in arts}
        raise Fail(1, not_found(f"no artifact {ga}:{version}", suggest(f"{ga}:{version}", all_ga)))
    return sorted(jar_classes(matching[0].path))


def parse(argv):
    positional, flags = [], {}
    literal = False
    i = 0
    while i < len(argv):
        arg = argv[i]
        i += 1
        if literal or arg == "-" or not arg.startswith("-"):
            positional.append(arg)
            continue
        if arg == "--":
            literal = True
            continue
        name, eq, value = arg.partition("=")
        if name not in FLAG_NAMES:
            raise Fail(2, f"unknown flag: {name}")
        if not eq:
            if i >= len(argv):
                raise Fail(2, f"error: {name} needs a value")
            value = argv[i]
            i += 1
        flags[name] = value
    return positional, flags


def run(argv):
    positional, flags = parse(argv)
    if not positional:
        raise Fail(2, "error: missing subcommand: expected find, cat or ls")
    sub, args = positional[0], positional[1:]
    if sub not in SUBCOMMANDS:
        raise Fail(2, f"error: unknown subcommand: {sub}")
    allowed = {"--root"} | ({"--lines"} if sub == "cat" else set())
    for name in flags:
        if name not in allowed:
            raise Fail(2, f"unknown flag: {name}")
    if len(args) != 1:
        raise Fail(2, f"error: {sub} takes exactly one argument")

    root = flags.get("--root", ".")
    if sub == "find":
        return cmd_find(args[0], root)
    if sub == "cat":
        line_range = parse_lines(flags["--lines"]) if "--lines" in flags else None
        return cmd_cat(args[0], root, line_range)
    return cmd_ls(args[0], root)


def main(argv):
    if "--help" in argv:
        write(sys.stdout, HELP.splitlines())
        return 0
    try:
        lines = run(argv)
    except Fail as f:
        write(sys.stderr, [f.line])
        return f.code
    write(sys.stdout, lines)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
