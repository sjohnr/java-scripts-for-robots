#!/bin/sh
# Wrapper: compiles on first use, then runs.
d=$(cd "$(dirname "$0")" && pwd)
if [ ! -f "$d/build/Logsum.class" ] || [ "$d/src/Logsum.java" -nt "$d/build/Logsum.class" ]; then
  mkdir -p "$d/build" && javac -d "$d/build" "$d/src/Logsum.java" || exit 1
fi
exec java -Xshare:auto -cp "$d/build" Logsum "$@"
