#!/usr/bin/env python3
"""logsum: streaming summary of a log file (or stdin). See SPEC.md."""

import re
import sys
from datetime import datetime

LEVELS = ("DEBUG", "INFO", "WARN", "ERROR")

HELP = """\
usage: logsum [FILE] [--since TIMESTAMP] [--level LEVEL] [--top N]

Summarize a log file whose lines look like: TIMESTAMP LEVEL MESSAGE

arguments:
  FILE                 log file to read; omitted or '-' reads stdin

flags:
  --since TIMESTAMP    only consider lines with timestamp >= TIMESTAMP
                       (format YYYY-MM-DDTHH:MM:SS)
  --level LEVEL        only consider lines at exactly LEVEL
                       (DEBUG, INFO, WARN or ERROR)
  --top N              number of top error groups to show (default 5)
  --help               show this help and exit
"""

TS_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}", re.ASCII)
LINE_RE = re.compile(r"(\S+)\s+(\S+)\s+(\S.*)", re.ASCII | re.DOTALL)

UUID_RE = re.compile(
    r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
HEX_RE = re.compile(r"\b(?=[0-9a-fA-F]*[a-fA-F])[0-9a-fA-F]{6,}\b", re.ASCII)
NUM_RE = re.compile(r"[0-9]+")


class UsageError(Exception):
    pass


def valid_timestamp(s):
    if not TS_RE.fullmatch(s):
        return False
    try:
        datetime.strptime(s, "%Y-%m-%dT%H:%M:%S")
    except ValueError:
        return False
    return True


def normalize(msg):
    msg = UUID_RE.sub("<uuid>", msg)
    msg = HEX_RE.sub("<hex>", msg)
    return NUM_RE.sub("<num>", msg)


def parse_args(argv):
    opts = {"file": None, "since": None, "level": None, "top": 5}
    flags = ("--since", "--level", "--top")
    i = 0
    only_positional = False
    while i < len(argv):
        arg = argv[i]
        i += 1
        if only_positional or arg == "-" or not arg.startswith("-"):
            if opts["file"] is not None:
                raise UsageError("error: unexpected argument: %s" % arg)
            opts["file"] = arg
            continue
        if arg == "--":
            only_positional = True
            continue
        name, eq, value = arg.partition("=")
        if name not in flags:
            raise UsageError("unknown flag: %s" % arg)
        if not eq:
            if i >= len(argv):
                raise UsageError("error: missing value for %s" % name)
            value = argv[i]
            i += 1
        if name == "--since":
            if not valid_timestamp(value):
                raise UsageError("error: invalid value for --since: %s" % value)
            opts["since"] = value
        elif name == "--level":
            if value not in LEVELS:
                raise UsageError("error: invalid value for --level: %s" % value)
            opts["level"] = value
        else:
            if not re.fullmatch(r"[0-9]+", value, re.ASCII):
                raise UsageError("error: invalid value for --top: %s" % value)
            opts["top"] = int(value)
    return opts


def summarize(stream, since, level_filter, top):
    total = 0
    counts = dict.fromkeys(LEVELS, 0)
    first = last = None
    groups = {}  # normalized -> [count, first-seen original message]

    for raw in stream:
        line = raw.decode("utf-8", errors="replace").rstrip()
        m = LINE_RE.fullmatch(line)
        if not m:
            continue
        ts, level, msg = m.groups()
        if level not in counts or not valid_timestamp(ts):
            continue
        if since is not None and ts < since:
            continue
        if level_filter is not None and level != level_filter:
            continue

        total += 1
        counts[level] += 1
        if first is None:
            first = ts
        last = ts
        if level == "ERROR":
            key = normalize(msg)
            group = groups.get(key)
            if group is None:
                groups[key] = [1, msg]
            else:
                group[0] += 1

    ranked = sorted(groups.values(), key=lambda g: (-g[0], g[1]))[:top]
    out = [
        "total: %d" % total,
        "by level: " + " ".join("%s=%d" % (lv, counts[lv]) for lv in LEVELS),
        "first: %s" % (first or "n/a"),
        "last: %s" % (last or "n/a"),
        "top errors:",
    ]
    out.extend("  %d %s" % (count, msg) for count, msg in ranked)
    return "".join(s + "\n" for s in out)


def main(argv):
    if "--help" in argv[: argv.index("--") if "--" in argv else len(argv)]:
        sys.stdout.buffer.write(HELP.encode("utf-8"))
        return 0
    try:
        opts = parse_args(argv)
    except UsageError as e:
        sys.stderr.buffer.write((str(e) + "\n").encode("utf-8"))
        return 2

    path = opts["file"]
    if path is None or path == "-":
        stream = sys.stdin.buffer
    else:
        try:
            stream = open(path, "rb")
        except OSError:
            sys.stderr.buffer.write(("error: cannot read %s\n" % path).encode("utf-8"))
            return 2

    try:
        result = summarize(stream, opts["since"], opts["level"], opts["top"])
    except OSError:
        sys.stderr.buffer.write(("error: cannot read %s\n" % (path or "-")).encode("utf-8"))
        return 2
    finally:
        if stream is not sys.stdin.buffer:
            stream.close()

    sys.stdout.buffer.write(result.encode("utf-8"))
    sys.stdout.buffer.flush()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        # Reader went away; silence the interpreter's flush-at-exit complaint.
        import os
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        sys.exit(0)
