#!/usr/bin/env python3
"""logsum: streaming summary of a log file (or stdin). See SPEC.md."""

import re
import sys
from datetime import datetime

LEVELS = ("DEBUG", "INFO", "WARN", "ERROR")
DEFAULT_TOP = 5

USAGE = """\
usage: logsum [FILE] [--since TIMESTAMP] [--level LEVEL] [--top N]

positional arguments:
  FILE                 log file to read; omitted or '-' reads stdin

options:
  --since TIMESTAMP    only count lines with TIMESTAMP >= TIMESTAMP
                       (format YYYY-MM-DDTHH:MM:SS)
  --level LEVEL        only count lines at LEVEL (DEBUG, INFO, WARN, ERROR)
  --top N              number of error groups to show (default 5)
  --help               show this help and exit
"""

TIMESTAMP_RE = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}")
UUID_RE = re.compile(
    r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"
)
HEX_RE = re.compile(r"\b(?=[0-9a-fA-F]*[a-fA-F])[0-9a-fA-F]{6,}\b", re.ASCII)
NUM_RE = re.compile(r"[0-9]+")


def fail(message):
    sys.stderr.write(message + "\n")
    sys.exit(2)


def is_timestamp(value):
    if not TIMESTAMP_RE.fullmatch(value):
        return False
    try:
        datetime.strptime(value, "%Y-%m-%dT%H:%M:%S")
    except ValueError:
        return False
    return True


def normalize(message):
    message = UUID_RE.sub("<uuid>", message)
    message = HEX_RE.sub("<hex>", message)
    return NUM_RE.sub("<num>", message)


def parse_args(argv):
    opts = {"file": None, "since": None, "level": None, "top": DEFAULT_TOP}
    positional = []
    end_of_options = False
    i = 0
    while i < len(argv):
        arg = argv[i]
        i += 1
        if end_of_options or arg == "-" or not arg.startswith("-"):
            positional.append(arg)
            continue
        if arg == "--":
            end_of_options = True
            continue

        name, has_value, value = arg.partition("=")
        if name == "--help":
            sys.stdout.write(USAGE)
            sys.exit(0)
        if name not in ("--since", "--level", "--top"):
            fail(f"unknown flag: {name}")
        if not has_value:
            if i >= len(argv):
                fail(f"error: option {name} requires a value")
            value = argv[i]
            i += 1

        if name == "--since":
            if not is_timestamp(value):
                fail(f"error: invalid value for --since: {value}")
            opts["since"] = value
        elif name == "--level":
            if value not in LEVELS:
                fail(f"error: invalid value for --level: {value}")
            opts["level"] = value
        else:
            if not re.fullmatch(r"[0-9]+", value):
                fail(f"error: invalid value for --top: {value}")
            opts["top"] = int(value)

    if len(positional) > 1:
        fail(f"error: unexpected argument: {positional[1]}")
    if positional:
        opts["file"] = positional[0]
    return opts


def parse_line(raw):
    """Return (timestamp, level, message) or None if the line is skipped."""
    line = raw.decode("utf-8", errors="replace")
    if len(line.split()) < 3:
        return None
    parts = line.split(" ", 2)
    if len(parts) < 3:
        return None
    timestamp, level, message = parts
    if level not in LEVELS or not is_timestamp(timestamp):
        return None
    return timestamp, level, message.rstrip()


def summarize(lines, since, level_filter):
    counts = dict.fromkeys(LEVELS, 0)
    total = 0
    first = None
    last = None
    groups = {}  # normalized message -> [count, first-seen display message]

    for raw in lines:
        parsed = parse_line(raw.rstrip(b"\n"))
        if parsed is None:
            continue
        timestamp, level, message = parsed
        if since is not None and timestamp < since:
            continue
        if level_filter is not None and level != level_filter:
            continue

        total += 1
        counts[level] += 1
        if first is None:
            first = timestamp
        last = timestamp

        if level == "ERROR":
            key = normalize(message)
            group = groups.get(key)
            if group is None:
                groups[key] = [1, message]
            else:
                group[0] += 1

    return total, counts, first, last, groups


def render(total, counts, first, last, groups, top):
    out = [
        f"total: {total}",
        "by level: " + " ".join(f"{level}={counts[level]}" for level in LEVELS),
        f"first: {first if first is not None else 'n/a'}",
        f"last: {last if last is not None else 'n/a'}",
        "top errors:",
    ]
    ranked = sorted(groups.values(), key=lambda group: (-group[0], group[1]))
    for count, message in ranked[:top]:
        out.append(f"  {count} {message}")
    return "\n".join(out) + "\n"


def main(argv):
    opts = parse_args(argv)

    if opts["file"] is None or opts["file"] == "-":
        total, counts, first, last, groups = summarize(
            sys.stdin.buffer, opts["since"], opts["level"]
        )
    else:
        try:
            with open(opts["file"], "rb") as handle:
                total, counts, first, last, groups = summarize(
                    handle, opts["since"], opts["level"]
                )
        except OSError:
            fail(f"error: cannot read {opts['file']}")

    sys.stdout.buffer.write(
        render(total, counts, first, last, groups, opts["top"]).encode("utf-8")
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
